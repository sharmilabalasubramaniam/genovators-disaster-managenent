# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: point to a self-hosted / private OpenAI-compatible endpoint (vLLM, Ollama, Azure...)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Key that authorized humans (police / relief officers) use to verify and reunite cases.
# The AI agent NEVER sees or uses this key. Endpoints stay disabled until it is set.
AUTHORITY_API_KEY=change-me-to-a-long-random-string

RESQLINK_DB=resqlink.db
